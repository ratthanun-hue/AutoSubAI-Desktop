{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoSubAI",
  "version": "1.9.1",
  "identifier": "com.thaiautosub.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "AutoSubAI Desktop Studio — Drama Subtitling, Style Inspector & Local Video Finishing",
        "width": 1520,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": [
      "resources/fonts/Prompt-Bold.ttf",
      "resources/fonts/Prompt-SemiBold.ttf",
      "resources/fonts/Kanit-Bold.ttf",
      "resources/fonts/Sarabun-Bold.ttf",
      "resources/THIRD-PARTY-LICENSES.txt"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
